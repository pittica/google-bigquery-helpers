{
  "name": "@pittica/google-bigquery-helpers",
  "private": false,
  "version": "1.4.7",
  "description": "Helpers for Google Cloud BigQuery.",
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf ./dist && mkdirp ./dist && babel src --out-dir dist --copy-files",
    "test": "echo \"Error: no test specified\" && exit 1",
    "list-datasets": "npm run build && run-func ./dist/scripts.js listDatasets",
    "list-tables": "npm run build && run-func ./dist/scripts.js listTables"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pittica/google-bigquery-helpers.git"
  },
  "keywords": [
    "pittica",
    "bigquery",
    "google-cloud-platform",
    "gcp"
  ],
  "author": "Lucio Benini <lucio.benini@pittica.com>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/pittica/google-bigquery-helpers/issues"
  },
  "homepage": "https://github.com/pittica/google-bigquery-helpers#README.md",
  "dependencies": {
    "@google-cloud/bigquery": "^8.3.1",
    "@pittica/logger-helpers": "^1.0.5"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "mkdirp": "^3.0.1",
    "prettier": "^3.9.0",
    "rimraf": "^6.1.3",
    "run-func": "^3.0.0"
  }
}
